# Copy this file to .env.local and fill in whichever keys you have.
# The app runs fine with none of these set - the AI tutor and read-aloud
# features just show a "not connected yet" message until you add a key.

# --- AI tutor providers (used by src/lib/ai) ---
OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Text-to-speech providers (used by src/lib/textToSpeech) ---
ELEVENLABS_API_KEY=
# Gemini TTS reuses GOOGLE_GEMINI_API_KEY above.
